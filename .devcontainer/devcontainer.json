{
  "name": "NFT Portfolio Lite",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "forwardPorts": [4180],
  "portsAttributes": {
    "4180": {
      "label": "NFT Portfolio Lite",
      "onAutoForward": "openBrowser"
    }
  },
  "secrets": {
    "OPENSEA_API_KEY": {
      "description": "Optional. Only needed to add NFTs by hand (staked or held by another contract). The portfolio itself works without it.",
      "documentationUrl": "https://docs.opensea.io/reference/api-keys"
    }
  }
}
